{
  "model": "sonnet",
  "effortLevel": "high",
  "attribution": {
    "commit": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\Jonathan\\Projects\\personal-dev-os\\scripts\\hook-session-start.ps1\"",
            "timeout": 15,
            "statusMessage": "DevOS session context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\Jonathan\\Projects\\personal-dev-os\\scripts\\hook-guard-force-push.ps1\"",
            "if": "Bash(git *)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\Jonathan\\Projects\\personal-dev-os\\scripts\\hook-guard-force-push.ps1\"",
            "if": "PowerShell(git *)",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./**/.env)",
      "Edit(./**/.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./secrets/**)",
      "Edit(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)"
    ]
  }
}
